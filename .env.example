# ==============================================================================
# AR-IMMS Biến môi trường mẫu (Environment Configuration Template)
# ==============================================================================

# Flask Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=ar_imms_super_secret_jwt_key_2026

# Docker Compose PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=ar_imms
DB_PORT=5432

# URL kết nối CSDL (Khi chạy trực tiếp trên máy host trỏ tới container Postgres)
DATABASE_URI=postgresql://postgres:postgres_password@localhost:5432/ar_imms

# PostgreSQL Supabase Cloud URL (Tùy chọn nếu dùng Cloud thay vì Docker Postgres)
# POSTGRES_DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Cấu hình chu kỳ giám sát Telemetry
TELEMETRY_INTERVAL=5
STALE_TIMEOUT=90

# Tự động nạp dữ liệu mẫu ban đầu (Auto-Seed)
AUTO_SEED=true
