# =============================================================================
# AR-IMMS .gitignore - Quy Tắc Bỏ Qua Tệp Dự Án (Backend, Frontend, Mobile)
# =============================================================================

# 1. Môi Trường & Khóa Bí Mật (Environment & Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
RUN_BACKEND.md
# 2. Công Cụ Hỗ Trợ AI & IDE
.agents/
.claude/
.gemini/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 3. Python & Môi Trường Ảo (Backend & Collector)
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# 4. Cơ Sở Dữ Liệu Cục Bộ (Databases & SQLite)
*.db
*.sqlite
*.sqlite3
default.db
test.db
instance/
backend/src/instance/

# 5. Node.js, Frontend Web (fontend & frontend)
node_modules/
*/node_modules/
fontend/node_modules/
frontend/node_modules/
mobile/node_modules/
.next/
*/.next/
fontend/.next/
frontend/.next/
out/
fontend/out/
frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Ứng Dụng Mobile (React Native / Expo / Android / iOS)
.expo/
mobile/.expo/
mobile/android/app/.cxx/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/build/

# 7. Tài Liệu & LaTeX Build Artifacts
docs/SRS/*.aux
docs/SRS/*.log
docs/SRS/*.lot
docs/SRS/*.out
docs/SRS/*.toc
docs/SRS/*.fls
docs/SRS/*.fdb_latexmk
docs/SRS/*.synctex.gz
*.aux
*.log
*.lot
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# 8. Tệp Tạm Microsoft Office Auto-saves
~$*.docx
~$*.xlsx
~$*.pptx
